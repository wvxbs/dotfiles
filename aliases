_in_cws_context() {
  [[ "$PWD/" == "$CWS_HOME/"* ]]
}

_docker_active_user() {
  local config_dir="$HOME/.docker"
  local credential_store helper server user

  if [[ "$(uname -s)" == "Darwin" ]] && _in_cws_context; then
    config_dir="$CWS_HOME/.docker"
  fi

  credential_store="$(
    command jq -r '.credsStore // empty' "$config_dir/config.json" 2>/dev/null
  )"
  [[ -z "$credential_store" ]] && return 1

  helper="docker-credential-$credential_store"
  for server in \
    'https://index.docker.io/v1/' \
    'https://index.docker.io/v1' \
    'registry-1.docker.io'; do
    user="$(
      print -rn -- "$server" | command "$helper" get 2>/dev/null |
        command jq -r '.Username // empty' 2>/dev/null
    )"
    if [[ -n "$user" && "$user" != '<token>' ]]; then
      print -r -- "$user"
      return 0
    fi
  done

  return 1
}

whoami() {
  local github_user git_name git_email docker_user

  command whoami

  _sync_github_context
  github_user="$(_github_active_user)"

  if _in_cws_context && ! command git rev-parse --git-dir >/dev/null 2>&1; then
    git_name="$(command git config --file "$CWS_HOME/.gitconfig" user.name 2>/dev/null)"
    git_email="$(command git config --file "$CWS_HOME/.gitconfig" user.email 2>/dev/null)"
  else
    git_name="$(command git config user.name 2>/dev/null)"
    git_email="$(command git config user.email 2>/dev/null)"
  fi
  docker_user="$(_docker_active_user)"

  print -r -- "GitHub : ${github_user:-não autenticado}"
  print -r -- "Git    : ${git_name:-não configurado}${git_email:+ <$git_email>}"
  print -r -- "Docker : ${docker_user:-não autenticado}"
}

_context_cd() {
  local target="$1"

  if _in_cws_context; then
    builtin cd -- "$CWS_HOME/$target"
  else
    builtin cd -- "$HOME/Documents/$target"
  fi
}

repos() { _context_cd repos; }
tools() { _context_cd tools; }

