##############################
### ALIASES — BASE         ###
##############################

# Navegação e Arquivos[cite: 1]
alias ls='eza -al --icons -I ".DS_Store"'
alias ..='cd ..'
alias mkdir='mkdir -pv'
alias cat='bat'
alias mv='mv -i'
alias cp='cp -i'
alias rm='rm -i'
alias ln='ln -i'

# Editor[cite: 1]
alias vim='nvim'
alias svim='sudo nvim'

# Shell e dotfiles[cite: 1]
alias src='source ~/.zshrc'
alias cfg='nvim ~/.zshrc'
alias aliases='nvim "$HOME/Documents/tools/dotfiles/aliases"'
alias bashtop='bpytop'

########################################
### CARREGADOR DE CONTEXTOS (LOADER) ###
########################################
# Procura por arquivos .zsh dentro da pasta 'contexts' e os executa.
# Basta criar arquivos lá dentro para adicionar um contexto, ou remover para desligar.
DOTFILES_DIR="$HOME/Documents/tools/dotfiles"
if [[ -d "$DOTFILES_DIR/contexts" ]]; then
  for ctx_file in "$DOTFILES_DIR/contexts"/*.zsh(N); do
    [[ -f "$ctx_file" ]] && source "$ctx_file"
  done
fi
