#!/bin/sh

set -eu

helper='docker-credential-osxkeychain'
action="${1:-}"

namespaced_server() {
  server_hash="$(
    printf '%s' "$1" | shasum -a 256 | cut -c1-40
  )"
  printf 'https://cws-%s.docker-credential.local/' "$server_hash"
}

case "$action" in
  store)
    payload="$(cat)"
    server="$(printf '%s' "$payload" | jq -r '.ServerURL')"
    namespaced_server="$(namespaced_server "$server")"
    printf '%s' "$payload" |
      jq --arg server "$namespaced_server" '.ServerURL = $server' |
      "$helper" store
    ;;
  get|erase)
    IFS= read -r server || [ -n "$server" ]
    namespaced_server="$(namespaced_server "$server")"
    printf '%s' "$namespaced_server" | "$helper" "$action"
    ;;
  *)
    printf 'usage: %s store|get|erase\n' "$0" >&2
    exit 64
    ;;
esac
