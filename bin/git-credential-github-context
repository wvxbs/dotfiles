#!/bin/sh

set -eu

cws_home="${CWS_HOME:-$HOME/Documents/Trabalho/cws}"
personal_user='wvxbs'
work_user='gabriel-ferreira-cws'

case "$PWD/" in
  "$cws_home"/*) github_user="$work_user" ;;
  *)             github_user="$personal_user" ;;
esac

gh auth switch \
  --hostname github.com \
  --user "$github_user" >/dev/null 2>&1

exec gh auth git-credential "$@"
